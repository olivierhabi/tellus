<!--
  Override the default user's networks so the B10 client can reach the
  server from the host (127.0.0.1:8123) as well as from inside the compose
  network. Password is injected via env vars; if you forget to set them,
  the image defaults leave the user unauthenticated on localhost only.
-->
<clickhouse>
  <users>
    <default>
      <networks>
        <ip>::/0</ip>
      </networks>
    </default>
  </users>
</clickhouse>
