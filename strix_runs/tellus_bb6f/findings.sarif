            "strix_vuln_class_hash": "86b935a2f6368779559d62f2eafaf03748506294adada8ac8ff7b9a86a3f10d5",
            "synthetic_location": true,
            "strix": {
              "id": "vuln-0029",
              "severity": "high",
              "cvss": 7.5,
              "timestamp": "2026-08-18 06:46:54 UTC",
              "target": "/workspace/tellus",
              "cve": "CVE-2026-13149",
              "cwe": "CWE-407",
              "impact": "A crafted brace pattern triggers exponential-time `expand()`, causing CPU-exhaustion DoS. Reached through the duckdb native build/fetch toolchain (`node-gyp`/`minimatch`), i.e. at build/install time rather than request-handling time. Availability impact.",
              "technical_analysis": "**Root cause:** exponential time in `expand()` on adversarial patterns (node-tar/minimatch family). **Two lockfile copies, same CVE:** `brace-expansion@1.1.12` (duckdb > node-gyp > glob@7 > minimatch@3) and `brace-expansion@2.1.0` (duckdb > node-gyp > make-fetch-happen > cacache > glob@8 > minimatch@5). **Trivy:** Severity=HIGH, CVSS 7.5 (CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H), CWE-407.",
              "remediation_steps": "Resolve both copies: `pnpm.overrides: { \"brace-expansion@<1.1.16\": \"^1.1.16\", \"brace-expansion@>=2.0.0 <2.1.2\": \"^2.1.2\" }` in `package.json`, then `pnpm install` and verify with `trivy fs pnpm-lock.yaml`. Alternatively bump `duckdb` to a release whose build closure picks fixed versions.",
              "dependency_metadata": {
                "package_name": "brace-expansion",
                "installed_version": "1.1.12",
                "package_ecosystem": "npm",
                "manifest_path": "pnpm-lock.yaml",
                "fixed_version": "1.1.16",
                "introduced_by": "duckdb@1.4.4",
                "dependency_path": "duckdb@1.4.4 > node-gyp@9.4.1 > glob@7.2.3 > minimatch@3.1.5 > brace-expansion@1.1.12",
                "reachability": "imported",
                "reachability_evidence": "No direct `brace-expansion` import in application code. Two pinned copies (`1.1.12` via `glob@7.2.3 > minimatch@3.1.5`, and `2.1.0` via `cacache@16.1.3 > glob@8.1.0 > minimatch@5.1.9`) both roll up to the direct dep `duckdb@1.4.4`. `duckdb` is required in src/services/furnaceSqlService.ts:55 and src/services/duckdb/pool.ts:49. Affected-symbol (`expand`) check inside minimatch was not performed."
              }
            }
          }
        },
