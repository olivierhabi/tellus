          },
          "properties": {
            "security-severity": "7.5",
            "strix_vuln_class_hash": "2e6f1a6d37556ad51a3b1e76ff436c9474258dac4104e3bdafd2bfe0b806b21c",
            "synthetic_location": true,
            "strix": {
              "id": "vuln-0025",
              "severity": "high",
              "cvss": 7.5,
              "timestamp": "2026-08-18 06:44:56 UTC",
              "target": "/workspace/tellus",
              "cve": "CVE-2026-59877",
              "cwe": "CWE-835",
              "impact": "A crafted `.proto` schema causes an infinite loop in the OTLP gRPC exporter's proto loading, hanging the Node.js event loop. Availability impact; requires a hostile schema to be loaded through the OpenTelemetry gRPC exporter path.",
              "technical_analysis": "**Root cause:** protobufjs < 7.6.5 / 8.6.6 loops indefinitely on a truncated option declaration. **Chain:** `@opentelemetry/sdk-node@0.218.0 > @opentelemetry/exporter-trace-otlp-grpc@0.218.0 > @grpc/grpc-js@1.14.4 > @grpc/proto-loader@0.8.0 > protobufjs@7.6.2`. **Trivy:** Severity=MEDIUM, CVSS nvd:7.5 (CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H), CWE-835.",
              "remediation_steps": "Bump `@opentelemetry/sdk-node` / `@opentelemetry/auto-instrumentations-node` to a release whose closure resolves `protobufjs@>=7.6.5`, or `pnpm.overrides: { \"protobufjs@7 <7.6.5\": \"^7.6.5\" }`. Regenerate lockfile, verify with `trivy fs pnpm-lock.yaml`.",
              "dependency_metadata": {
                "package_name": "protobufjs",
                "installed_version": "7.6.2",
                "package_ecosystem": "npm",
                "manifest_path": "pnpm-lock.yaml",
                "fixed_version": "7.6.5",
                "introduced_by": "@opentelemetry/sdk-node@0.218.0",
                "dependency_path": "@opentelemetry/sdk-node@0.218.0 > @opentelemetry/exporter-trace-otlp-grpc@0.218.0 > @grpc/grpc-js@1.14.4 > @grpc/proto-loader@0.8.0 > protobufjs@7.6.2",
                "reachability": "imported",
                "reachability_evidence": "No direct `protobufjs` import in src. Reached through `@opentelemetry/sdk-node` (direct dep; `src/otelBootstrap.ts` initializes the OpenTelemetry SDK). The affected-symbol (`Root.load`/`Root.loadSync` with attacker-controlled schema) check inside `@grpc/proto-loader` was not performed — schemas are normally static."
              }
            }
          }
        },
