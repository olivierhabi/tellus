          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "src/services/codeRepository/admin/routes.ts"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 2741,
                        "endLine": 2742
                      },
                      "insertedContent": {
                        "text": "const rid = req.params.rid;\n      if (!isRid(rid)) return sendError(res, codeReposError(\"CodeRepos:RepositoryNotFound\", { rid }));\n\n      // Executing inlineSource / working-tree Functions runs arbitrary code.\n      // Gate it behind the same publish-authorization boundary used by the\n      // registry publish endpoints: while the executor is not an\n      // untrusted-code sandbox, only authorized authors may run server-side\n      // code. `authorizePublish` is imported from ../../functions/executionPolicy.\n      {\n        const principal = req.codeReposPrincipal;\n        if (!principal) {\n          return sendError(res, codeReposError(\"CodeRepos:Unauthenticated\", { reason: \"principal not bound\" }));\n        }\n        const decision = await authorizePublish(pool, {\n          localUserId: principal.userId,\n          keycloakSub: principal.keycloakSub,\n          roles: principal.roles,\n          repositoryRid: rid,\n          releaseTag: null,\n        });\n        if (!decision.allowed) {\n          return sendError(res, codeReposError(\"CodeRepos:PermissionDenied\", { reason: decision.reason }));\n        }\n      }"
                      }
                    }
                  ]
                },
                {
                  "artifactLocation": {
                    "uri": "src/services/codeRepos/middleware/principal.ts"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 40,
                        "endLine": 41
                      },
                      "insertedContent": {
                        "text": "// Removed: an always-authorized synthetic principal must never be\n// substituted for unauthenticated requests. Code-repositories routes\n// (including code-executing invoke) must require a real JWT/PAT.\n// Test-mode synthesis is restricted to an explicit X-Tellus-Test-Principal\n// header AND isTestAuthBypassEnabled, and never grants publish rights."
                      }
                    }
