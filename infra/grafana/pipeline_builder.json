{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Pipeline Builder — SLO",
  "uid": "pipeline-builder-slo",
  "tags": ["pipeline-builder", "pb-b9", "slo"],
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "pipeline_id",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "query": "label_values(pipeline_deploy_total, pipeline_id)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "title": "Deploy success rate (5m)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green",  "value": 0.995 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(pipeline_deploy_total{status=\"succeeded\"}[5m])) / clamp_min(sum(rate(pipeline_deploy_total[5m])), 0.001)",
          "legendFormat": "success_rate"
        }
      ]
    },
    {
      "title": "p95 deploy duration (seconds)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_deploy_duration_seconds_bucket[10m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "title": "p95 preview latency (seconds)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_preview_duration_seconds_bucket[10m])) by (le, transform_type))",
          "legendFormat": "{{transform_type}}"
        }
      ]
    },
    {
      "title": "Active deploys",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [{ "expr": "pipeline_active_deploys" }]
    },
    {
      "title": "Deploy total by status",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "sum by (status) (rate(pipeline_deploy_total[5m]))", "legendFormat": "{{status}}" }
      ]
    },
    {
      "title": "Input rows processed / s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "rate(pipeline_input_rows_processed_total[5m])", "legendFormat": "rows/s" }
      ]
    },
    {
      "title": "DuckDB memory (bytes, per node)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "duckdb_memory_bytes", "legendFormat": "{{node_id}}" }
      ]
    },
    {
      "title": "Iceberg snapshot commit duration — p95 per table",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, table) (rate(iceberg_snapshot_commit_duration_seconds_bucket[10m])))",
          "legendFormat": "{{table}}"
        }
      ]
    },
    {
      "title": "Temporal workflow failures / s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (workflow_type, reason) (rate(temporal_workflow_failures_total[5m]))",
          "legendFormat": "{{workflow_type}} / {{reason}}"
        }
      ]
    },
    {
      "title": "Orphan runs swept / s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        { "expr": "rate(pipeline_orphan_runs_swept_total[10m])", "legendFormat": "orphan_swept" }
      ]
    },
    {
      "title": "Readiness probe failures — per probe",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (probe) (rate(pipeline_health_check_failures_total[5m]))",
          "legendFormat": "{{probe}}"
        }
      ]
    }
  ]
}
