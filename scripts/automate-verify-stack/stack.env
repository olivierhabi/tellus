# Isolated Automate verification stack configuration.
# The up.sh script overrides the shared dev env with these values so a
# second Tellus API + FE run on dedicated ports against isolated
# database/realm/bucket namespaces, never competing with the shared
# dev servers (:3000/:3001).
#
# Ports are env-driven; change here (or export before running up.sh).

export VERIFY_API_PORT="${VERIFY_API_PORT:-3100}"     # isolated Tellus API
export VERIFY_FE_PORT="${VERIFY_FE_PORT:-3101}"        # isolated Next.js FE
export VERIFY_DB="${VERIFY_DB:-tellus_automate_verify}" # isolated PostgreSQL DB
export VERIFY_DB_USER="${VERIFY_DB_USER:-tellus}"      # same PG user; isolated DB only
export VERIFY_REALM="${VERIFY_REALM:-tellus-automate-verify}" # isolated Keycloak realm
export VERIFY_S3_BUCKET="${VERIFY_S3_BUCKET:-automate-verify}" # isolated MinIO bucket
export VERIFY_TENANT="${VERIFY_TENANT:-automate-verify}"     # isolated tenant id
export OWNER_EMAIL="${OWNER_EMAIL:-automate-verify-owner@tellus.local}"
export OWNER_PASS="${OWNER_PASS:-Password123!}"
export ADMIN_EMAIL="${ADMIN_EMAIL:-automate-verify-admin@tellus.local}"
export ADMIN_PASS="${ADMIN_PASS:-Password123!}"
export UNAUTH_EMAIL="${UNAUTH_EMAIL:-automate-verify-nobody@tellus.local}"
export UNAUTH_PASS="${UNAUTH_PASS:-Password123!}"

# ----------------------------------------------------------------------------
# Temporal / deployment identity isolation (FUNN-ISO).
#
# The 2026-07-31 incident: this stack started a Temporal worker on the SHARED
# `tellus-funnel` namespace + `tellus-funnel-queue`, so the dev API and the
# verify API executed each other's funnel activities against the wrong
# database (an OlivierOrder dev run was half-executed here, leaving the dev
# funnel_state stuck at 'indexing'). These exports close that hole:
#
#   VERIFY_STACK_ID        deterministic suffix so concurrent verify stacks
#                          on the same Temporal cluster get distinct ids.
#   TELLUS_ENVIRONMENT_ID  deployment identity; sealed into the verify DB
#                          (`deployment_environment`) by the worker at boot —
#                          any worker pointing at this DB with a different id
#                          refuses to start.
#   TEMPORAL_NAMESPACE     own Temporal namespace (provisioned by up.sh).
#   TEMPORAL_TASK_QUEUE    own queue; Temporal never dispatches across queues.
#   TEMPORAL_WORKER_BUILD_ID  worker version for poller attribution.
#
# Sourced by up.sh AND by verify gate scripts (which inherit this whole file),
# so migration, seed, cleanup, and test processes all see the same identity.
# ----------------------------------------------------------------------------
export VERIFY_STACK_ID="${VERIFY_STACK_ID:-main}"
export TELLUS_ENVIRONMENT_ID="${TELLUS_ENVIRONMENT_ID:-tellus-automate-verify-${VERIFY_STACK_ID}}"
export TEMPORAL_NAMESPACE="${TEMPORAL_NAMESPACE:-tellus-funnel-verify-${VERIFY_STACK_ID}}"
export TEMPORAL_TASK_QUEUE="${TEMPORAL_TASK_QUEUE:-tellus-funnel-verify-${VERIFY_STACK_ID}}"
export TEMPORAL_WORKER_BUILD_ID="${TEMPORAL_WORKER_BUILD_ID:-$(git rev-parse --short=12 HEAD 2>/dev/null || echo dev)}"
# Namespace retention for THIS verify stack (Temporal keeps closed history
# this long; TTL expiry is the documented cleanup policy for ephemeral
# namespaces — down.sh additionally terminates open workflows).
export VERIFY_TEMPORAL_RETENTION="${VERIFY_TEMPORAL_RETENTION:-72h}"
