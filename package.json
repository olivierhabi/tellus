    "@opentelemetry/sdk-node": "^0.222.0",
    "@simplewebauthn/server": "^14.0.1",
    "@smithy/node-http-handler": "^4.12.1",
    "@temporalio/activity": "1.16.0",
    "@temporalio/client": "1.16.0",
    "@temporalio/common": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.16.0",
    "ajv": "8.18.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.1",
    "duckdb": "^1.4.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "kafkajs": "^2.2.4",
    "kafkajs-snappy": "^1.1.0",
    "knex": "^3.3.0",
    "libpg-query": "^17.7.3",
    "lru-cache": "^11.5.2",
    "luxon": "^3.7.2",
    "multer": "^2.3.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "seedrandom": "^3.0.5",
    "typescript": "^6.0.3",
    "uuid": "^13.0.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^11.0.0",
    "cypress": "^13.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mongodb-js/zstd",
      "@parcel/watcher",
      "cpu-features",
