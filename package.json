      "esbuild",
      "msgpackr-extract",
      "protobufjs",
      "ssh2"
    ],
    "overrides": {
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "@opentelemetry/propagator-jaeger@<2.9.0": "^2.9.0",
      "adm-zip@<0.6.0": "^0.6.0",
      "brace-expansion@5": "^5.0.9",
      "brace-expansion@<2": "^1.1.20",
      "brace-expansion@>=2 <2.1.4": "^2.1.4",
      "fast-uri@<3.1.7": "^3.1.7",
      "fast-xml-builder@<1.1.7": "^1.1.7",
      "fast-xml-parser@<5.7.0": "^5.7.0",
      "form-data@<4.0.6": "^4.0.6",
      "ip-address@<10.3.1": "^10.3.1",
      "browserslist@<4.28.7": "^4.28.7",
