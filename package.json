{
  "name": "ontology-engine",
  "version": "0.3.0",
  "description": "Ontology Engine - a robust PostgreSQL-backed API server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run build:copy-assets",
    "build:copy-assets": "node -e \"const fs=require('fs'),path=require('path');function copy(s,d){fs.mkdirSync(d,{recursive:true});for(const e of fs.readdirSync(s,{withFileTypes:true})){const a=path.join(s,e.name),b=path.join(d,e.name);if(e.isDirectory())copy(a,b);else fs.copyFileSync(a,b);}}copy(path.join(__dirname,'src/templates'),path.join(__dirname,'dist/templates'));console.log('[build] copied src/templates -> dist/templates');\"",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:foundry": "tsx src/foundryMigrate.ts",
    "migrate:auth": "tsx src/migrateAuth.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:monday": "vitest run tests/monday",
    "test:monday:unit": "vitest run tests/monday/unit",
    "test:monday:integration": "vitest run tests/monday/integration",
    "test:monday:e2e": "bash tests/monday/e2e/suite.sh",
    "test:tuesday": "vitest run tests/tuesday",
    "test:tuesday:unit": "vitest run tests/tuesday/unit",
    "test:tuesday:integration": "vitest run tests/tuesday/integration",
    "test:tuesday:e2e": "bash tests/tuesday/e2e/suite.sh",
    "test:wednesday": "vitest run tests/wednesday",
    "test:wednesday:unit": "vitest run tests/wednesday/unit",
    "test:wednesday:integration": "vitest run tests/wednesday/integration",
    "test:wednesday:e2e": "bash tests/wednesday/e2e/suite.sh",
    "test:thursday": "vitest run tests/thursday",
    "test:thursday:unit": "vitest run tests/thursday/unit",
    "test:thursday:integration": "vitest run tests/thursday/integration",
    "test:thursday:e2e": "bash tests/thursday/e2e/suite.sh",
    "test:friday": "vitest run tests/friday",
    "test:friday:unit": "vitest run tests/friday/unit",
    "test:friday:integration": "vitest run tests/friday/integration",
    "test:friday:e2e": "bash tests/friday/e2e/suite.sh",
    "test:saturday": "vitest run tests/saturday",
    "test:saturday:unit": "vitest run tests/saturday/unit",
    "test:saturday:integration": "vitest run tests/saturday/integration",
    "test:saturday:e2e": "bash tests/saturday/e2e/suite.sh",
    "test:sunday": "vitest run tests/sunday",
    "test:sunday:unit": "vitest run tests/sunday/unit",
    "test:sunday:integration": "vitest run tests/sunday/integration",
    "test:sunday:e2e": "bash tests/sunday/e2e/suite.sh",
    "test:sunday:perf": "tsx tests/performance/sundayBenchmark.ts",
    "test:foundry": "vitest run tests/foundry",
    "test:foundry:unit": "vitest run tests/foundry/unit",
    "test:foundry:integration": "vitest run tests/foundry/integration",
    "test:foundry:e2e": "bash tests/foundry/e2e/suite.sh",
    "test:unit": "vitest run tests/monday/unit tests/tuesday/unit tests/wednesday/unit tests/thursday/unit tests/friday/unit tests/saturday/unit tests/sunday/unit",
    "test:integration": "bash tests/integration/run-all.sh",
    "test:e2e": "bash tests/e2e/run-all.sh",
    "test:perf": "tsx tests/performance/benchmark.ts && tsx tests/performance/sundayBenchmark.ts",
    "test:all": "tsx tests/runAll.ts",
    "test:legacy": "tsx tests/index.ts",
    "seed:saturday-sunday": "tsx src/seeds/saturdaySundaySeed.ts",
    "seed:full": "tsx src/seeds/fullSeed.ts",
    "generate:api-docs": "tsx src/utils/generateApiDocs.ts",
    "auth:bootstrap": "bash scripts/bootstrap-keycloak.sh",
    "auth:verify": "bash scripts/verify-auth-all.sh",
    "auth:verify:realm": "bash scripts/verify-auth-realm.sh",
    "auth:verify:jwt": "bash scripts/verify-auth-jwt.sh",
    "auth:verify:oauth": "bash scripts/verify-auth-oauth.sh",
    "auth:verify:mfa": "bash scripts/verify-auth-mfa.sh",
    "auth:verify:pat": "bash scripts/verify-auth-pat.sh",
    "auth:verify:keycloak-only": "bash scripts/verify-auth-keycloak-only.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/lib-storage": "^3.1010.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@simplewebauthn/server": "^13.3.0",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.3.1",
    "duckdb": "^1.4.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "kafkajs": "^2.2.4",
    "knex": "^3.1.0",
    "lru-cache": "^11.2.7",
    "multer": "^1.4.5-lts.1",
    "nodejs-polars": "^0.24.1",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "seedrandom": "^3.0.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
