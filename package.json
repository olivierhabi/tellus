{
  "name": "ontology-engine",
  "version": "0.1.0",
  "description": "Ontology Engine - a robust PostgreSQL-backed API server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:monday": "vitest run tests/monday",
    "test:monday:unit": "vitest run tests/monday/unit",
    "test:monday:integration": "vitest run tests/monday/integration",
    "test:monday:e2e": "bash tests/monday/e2e/suite.sh",
    "test:tuesday": "vitest run tests/tuesday",
    "test:tuesday:unit": "vitest run tests/tuesday/unit",
    "test:tuesday:integration": "vitest run tests/tuesday/integration",
    "test:tuesday:e2e": "bash tests/tuesday/e2e/suite.sh",
    "test:wednesday": "vitest run tests/wednesday",
    "test:wednesday:unit": "vitest run tests/wednesday/unit",
    "test:wednesday:integration": "vitest run tests/wednesday/integration",
    "test:wednesday:e2e": "bash tests/wednesday/e2e/suite.sh",
    "test:thursday": "vitest run tests/thursday",
    "test:thursday:unit": "vitest run tests/thursday/unit",
    "test:thursday:integration": "vitest run tests/thursday/integration",
    "test:thursday:e2e": "bash tests/thursday/e2e/suite.sh",
    "test:friday": "vitest run tests/friday",
    "test:friday:unit": "vitest run tests/friday/unit",
    "test:friday:integration": "vitest run tests/friday/integration",
    "test:friday:e2e": "bash tests/friday/e2e/suite.sh",
    "test:unit": "vitest run tests/monday/unit tests/tuesday/unit tests/wednesday/unit tests/thursday/unit tests/friday/unit",
    "test:integration": "bash tests/integration/run-all.sh",
    "test:e2e": "bash tests/e2e/run-all.sh",
    "test:legacy": "tsx tests/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@opensearch-project/opensearch": "^3.5.1",
    "@types/swagger-ui-express": "^4.1.8",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "seedrandom": "^3.0.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/seedrandom": "^3.0.8",
    "@vitest/coverage-v8": "^4.0.18",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
