      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "postcss@8": "^8.5.23",
      "protobufjs@7": "^7.5.6",
      "protobufjs@8": "^8.0.2",
      "tar@<7.5.21": "^7.5.21",
      "vite@<8.0.5": "^8.0.5",
      "proxy-addr@<2.0.8": "^2.0.8",
      "source-map-js@<1.2.2": "^1.2.2"
