{
  "name": "ontology-engine",
  "version": "0.3.0",
  "description": "Ontology Engine - a robust PostgreSQL-backed API server",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && npm run build:copy-assets",
    "build:copy-assets": "bash scripts/copy-assets.sh",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:foundry": "tsx src/foundryMigrate.ts",
    "migrate:auth": "tsx src/migrateAuth.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:daily": "bash tests/daily/run-all.sh",
    "test:daily:unit": "bash tests/daily/run-unit.sh",
    "test:daily:integration": "bash tests/integration/run-all.sh",
    "test:daily:e2e": "bash tests/e2e/run-all.sh",
    "test:foundry": "vitest run tests/foundry",
    "test:foundry:unit": "vitest run tests/foundry/unit",
    "test:foundry:integration": "vitest run tests/foundry/integration",
    "test:foundry:e2e": "bash tests/foundry/e2e/suite.sh",
    "test:unit": "bash tests/daily/run-unit.sh",
    "test:integration": "bash tests/integration/run-all.sh",
    "test:e2e": "bash tests/e2e/run-all.sh",
    "test:pb": "npm run test:foundry:unit && npm run test:foundry:integration && bash scripts/test-pb-all-endpoints-e2e.sh",
    "test:pb:unit": "vitest run tests/foundry/unit",
    "test:pb:integration": "vitest run tests/foundry/integration",
    "test:pb:e2e": "bash scripts/test-pb-all-endpoints-e2e.sh",
    "test:pb:chaos": "bash scripts/test-pb-b9-db-kill-chaos.sh && bash scripts/test-pb-b9-lakekeeper-kill-chaos.sh && bash scripts/test-pb-b9-minio-kill-chaos.sh && bash scripts/test-pb-b9-temporal-kill-chaos.sh",
    "test:pb:observability": "bash scripts/verify-pb-b9-observability-stack.sh",
    "test:perf": "bash tests/performance/run-all.sh",
    "test:all": "tsx tests/runAll.ts",
    "test:legacy": "tsx tests/index.ts",
    "seed:saturday-sunday": "tsx src/seeds/saturdaySundaySeed.ts",
    "seed:full": "tsx src/seeds/fullSeed.ts",
    "generate:api-docs": "tsx src/utils/generateApiDocs.ts",
    "auth:bootstrap": "bash scripts/bootstrap-keycloak.sh",
    "auth:verify": "bash scripts/verify-auth-all.sh",
    "auth:verify:realm": "bash scripts/verify-auth-realm.sh",
    "auth:verify:jwt": "bash scripts/verify-auth-jwt.sh",
    "auth:verify:oauth": "bash scripts/verify-auth-oauth.sh",
    "auth:verify:mfa": "bash scripts/verify-auth-mfa.sh",
    "auth:verify:pat": "bash scripts/verify-auth-pat.sh",
    "auth:verify:keycloak-only": "bash scripts/verify-auth-keycloak-only.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/lib-storage": "^3.1010.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@opensearch-project/opensearch": "^3.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@simplewebauthn/server": "^13.3.0",
    "@temporalio/activity": "^1.11.6",
    "@temporalio/client": "^1.11.6",
    "@temporalio/worker": "^1.11.6",
    "@temporalio/workflow": "^1.11.6",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.3.1",
    "duckdb": "^1.4.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.0.1",
    "kafkajs": "^2.2.4",
    "knex": "^3.1.0",
    "lru-cache": "^11.2.7",
    "multer": "^1.4.5-lts.1",
    "nodejs-polars": "^0.24.1",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "seedrandom": "^3.0.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/seedrandom": "^3.0.8",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
