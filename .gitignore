# Dependencies
node_modules/

# Build output
dist/

# Environment variables (contain secrets)
.env
.env.local
.env.production

# AI agents
.claude
.vix


# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Test artifacts
coverage/
tests/**/tmp/

# Data files (user-specific)
data/

# Legacy local uploads (now stored in MinIO/S3)
uploads/

# Local code-repository working copies — runtime data, never committed.
# Code repositories persist to Postgres (coderepo_stemma_*); the on-disk
# var/tellus/repositories/ tree backed the removed DiskStemma adapter and
# is no longer read or written by any live code path.
var/

# Local DB backups (never commit dumps)
backups/

# OSDK codegen output (scripts/osdk-regen.ts) — regenerated, not committed
generated/osdk/

# Verbatim runtime evidence dumps (full workflow histories, raw search hits,
# tokens) — CI artifacts / dev machines only; see docs/evidence-policy.md.
# Redacted records and manifests elsewhere under .migration-evidence/ ARE committed.
.migration-evidence/raw/


.strix_runs/