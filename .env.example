# =============================================================================
# Tellus / Ontology Engine — environment template
#
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# Secrets (KEK, superadmin password, DB password, client secrets) MUST be
# sourced from a secrets manager in production — see SECURITY.md. The values
# here are non-functional placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL connection (REQUIRED — see REQUIRED_ENV_VARS in src/server.ts)
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=tellus_db
PGUSER=tellus
PGPASSWORD=changeme
# Optional: full connection URL used by some tooling/migrations.
# DATABASE_URL=postgresql://tellus:changeme@localhost:5432/tellus_db
# POSTGRES_URL=postgresql://tellus:changeme@localhost:5432/tellus_db

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
# NODE_ENV gates dev-only behaviour (CORS allow-all, test-auth bypasses).
# MUST be "production" in production.
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins.
# In production an empty value is FAIL-CLOSED (no cross-origin allowed); set the
# real frontend origin(s) explicitly, e.g. https://app.example.com
CORS_ORIGINS=

# Session lifetime — how long a user stays logged in before re-authenticating.
# A single knob drives the TELLUS_TOKEN + TELLUS_REFRESH cookie Max-Age AND the
# frontend session marker / forced-logout timer so they expire together; this is
# what keeps a duplicated/newly-opened tab signed in for the whole window.
# Accepts seconds or a duration suffix (s/m/h/d): 24h, 8h, 86400.
# Clamped to [60s, 30d]. Default when unset: 24h.
# This is the SINGLE source of truth — the frontend has no session-lifetime
# env var; it receives this window from the login response.
TELLUS_SESSION_MAX_AGE=24h

# Inactivity (idle) timeout — signs the user out after this long with NO
# mouse/keyboard/touch activity, even if the absolute session window above
# still has time left. Accepts seconds or a duration suffix (s/m/h/d):
# 30m, 24h, 1800. Clamped to [60s, TELLUS_SESSION_MAX_AGE]. Default: 30m.
# For "login at most once per day" set this equal to TELLUS_SESSION_MAX_AGE.
# Echoed to the frontend as `idleTimeoutSeconds`; the session-timeout modal
# warns 60s before logout. Backend-owned, like TELLUS_SESSION_MAX_AGE.
TELLUS_SESSION_IDLE_TIMEOUT=24h

# File datasource — base directory for allowed file paths
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Credential vault / KMS  (SECRET — externalize in production)
# -----------------------------------------------------------------------------
# Base64-encoded 32-byte master key encrypting all stored connection creds.
# Generate (dev only): openssl rand -base64 32
# In production this MUST come from a secrets manager / KMS, never a baked .env.
TELLUS_LOCAL_KEK_B64=
TELLUS_KMS_ADAPTER=local

# -----------------------------------------------------------------------------
# Bootstrap superadmin  (SECRET — externalize in production)
# -----------------------------------------------------------------------------
TELLUS_SUPERADMIN_EMAIL=admin@example.com
TELLUS_SUPERADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Keycloak (SSO / OAuth 2.0)
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8086
KEYCLOAK_REALM=tellus
KEYCLOAK_CLIENT_ID=tellus-api
KEYCLOAK_FRONTEND_CLIENT_ID=tellus-frontend
KEYCLOAK_CONFIDENTIAL_CLIENT_ID=tellus-confidential
# SECRET — externalize in production.
KEYCLOAK_CONFIDENTIAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Temporal (workflow engine)
# -----------------------------------------------------------------------------
# FUNN-ISO — deployment identity. In production-like environments
# (NODE_ENV=production or TELLUS_DEPLOYMENT_STRICT=1) ALL of
# TELLUS_ENVIRONMENT_ID / TEMPORAL_NAMESPACE / TEMPORAL_TASK_QUEUE are
# REQUIRED and startup fails without them; the local defaults below are the
# clearly-defined single-stack dev configuration and must never be shared
# between two databases.
TELLUS_ENVIRONMENT_ID=tellus-dev
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=tellus-funnel-tellus-dev
TEMPORAL_TASK_QUEUE=tellus-funnel-queue-tellus-dev

# -----------------------------------------------------------------------------
# ClickHouse (analytics)
# -----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123

# -----------------------------------------------------------------------------
# Lakekeeper / Iceberg catalog
# -----------------------------------------------------------------------------
LAKEKEEPER_URL=http://localhost:8181
LAKEKEEPER_WAREHOUSE=tellus
LAKEKEEPER_PIPELINE_WAREHOUSE=tellus-pipeline
TELLUS_ICEBERG_ROOT=s3://tellus-iceberg

# -----------------------------------------------------------------------------
# Batch compute engine (FOUNDRY-GAPS §1) — strangler-fig branch in
# deploymentService.executeBuild. Default "in-process" keeps the legacy
# Node path; "trino" dispatches engine-eligible builds (linear chain,
# Iceberg input ≥ MIN_ROWS) to Trino over the Lakekeeper REST catalog.
# -----------------------------------------------------------------------------
# TELLUS_BATCH_ENGINE=trino
# TELLUS_BATCH_ENGINE_MIN_ROWS=500000
# TRINO_URL=http://localhost:8088
# TRINO_USER=tellus
# TRINO_CATALOG=iceberg
# TRINO_STATEMENT_TIMEOUT_MS=1800000

# -----------------------------------------------------------------------------
# Redis (cache / rate-limit backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
TELLUS_REDIS_HOST=localhost
TELLUS_REDIS_PORT=6379
# RATE_LIMIT_BACKEND=redis

# -----------------------------------------------------------------------------
# Kafka (event streaming) — optional
# -----------------------------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
# SECRET — externalize when SASL is enabled.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO / S3 object storage
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tellus-uploads
S3_ACCESS_KEY_ID=minioadmin
# SECRET — externalize in production.
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Max upload size per file (MB) for project/folder + dataset uploads. Default 1024 (1 GB).
# Foundry project/folder uploads stream disk→S3 (multer diskStorage →
# fs.createReadStream → uploadObject), so a multi-GB upload never buffers in
# Node RAM; size the staging volume (UPLOAD_STAGING_DIR) instead.
MAX_FILE_SIZE_MB=1024
# Wall-clock budget (ms) for multipart upload requests (POST .../upload and
# .../transactions append). Default 600000 (10 min) — uploads move bytes so
# duration scales with file size, not handler work. Other routes stay at 5s.
UPLOAD_REQUEST_TIMEOUT_MS=600000

# -----------------------------------------------------------------------------
# Quiver / frontend
# -----------------------------------------------------------------------------
TELLUS_QUIVER_PHASE=
TELLUS_FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# AI Engine (telos-AIE-agent) — TypeScript Functions v2 + Vega chart agent.
# The tellus backend is the ONLY caller of this service; the frontend never
# sees this URL. Used by src/services/aiEngine/client.ts to proxy
# /api/v1/code-assistant/typescript-v2 and /vega-chart.
# -----------------------------------------------------------------------------
TELOS_AIE_AGENT_URL=http://127.0.0.1:5000
# Per-request timeout for an AI engine call (ms). LLM calls are slow.
AI_ENGINE_TIMEOUT_MS=120000
# Wall-clock budget for a /api/v1/code-assistant request (ms). Defaults to 5
# min so the streaming LLM agentic loop doesn't hit the global 5s data-plane
# budget (the route is exempted from the global budget + gets this ceiling).
CODE_ASSISTANT_REQUEST_TIMEOUT_MS=300000
# Optional shared secret for backend->engine auth (defense in depth). Must
# match the engine's ENGINE_AUTH_TOKEN; unset = open (network isolation).
# TELOS_AIE_AGENT_TOKEN=

# -----------------------------------------------------------------------------
# Test-auth bypass flags — DEVELOPMENT / CI ONLY.
# These MUST stay UNSET in production. They are additionally gated by
# NODE_ENV !== "production" in code (defense in depth), but do not rely on that:
# leave them unset in any production environment.
# -----------------------------------------------------------------------------
# QUIVER_ALLOW_TEST_AUTH=1
# CODE_REPOS_TEST_AUTH=1
# CODE_ASSISTANT_TEST_AUTH=1
# TELLUS_TEST_HOOKS=1

# -----------------------------------------------------------------------------
# Request budgets (milliseconds). The data-plane gets a 5s wall budget; the
# code-repositories mount (function invoke: transpile + ontology snapshot load
# + sandboxed run) is exempted from the global budget and gets its own longer
# ceiling, because a legitimate invoke cannot fit 5s. The sandbox's own
# FUNCTION_TIMEOUT_MS still bounds CPU.
# -----------------------------------------------------------------------------
# REQUEST_TIMEOUT_MS=5000
# CODE_REPOS_REQUEST_TIMEOUT_MS=30000
# Object read path (search/get/aggregate) — tolerates being queued behind a
# synchronous function-sandbox block (up to FUNCTION_TIMEOUT_MS). Must stay
# below the frontend axios timeout (NEXT_PUBLIC_API_TIMEOUT_MS, 30s default).
# OBJECTS_REQUEST_TIMEOUT_MS=15000
# Function ontology-snapshot cache TTL (coalesces the burst of invokes one
# Workshop table render fires). 0 disables caching.
# FUNCTION_SNAPSHOT_TTL_MS=5000
# Function sandbox worker pool. The sandbox runs in worker_threads so a long
# function cannot block the main event loop (which starved object-search reads
# to 504). Set FUNCTION_WORKER_POOL=0 to force the inline sync fallback.
# FUNCTION_WORKER_POOL=1
# FUNCTION_WORKER_POOL_SIZE=4

# -----------------------------------------------------------------------------
# Function PUBLISH authorization (execution security boundary).
# The executor is NOT an untrusted-code sandbox, so publication of executable
# Functions is gated by authorizePublish() (src/services/functions/
# executionPolicy.ts, migration 164), in order:
#   1. Keycloak publish role (below) — grants global publish rights.
#   2. function_publish_grants DB rows (global or repo-scoped) — manage via
#      /api/v1/functions/admin/function-publish-grants (superadmin only).
#   3. FUNCTION_TRUSTED_AUTHOR_IDS — DEPRECATED legacy fallback: still
#      honored, logs a once-per-process deprecation warning, audited as
#      decision_source=env_allowlist. Migrate with
#      scripts/import-function-trusted-authors.ts, then leave unset.
#   4. open-development trust mode — dev stacks only, REFUSED in production.
# Nothing configured => nobody can publish (fail closed). Every decision is
# written to function_publish_audit_log.
# -----------------------------------------------------------------------------
# FUNCTION_PUBLISH_ROLE=function:publish
# FUNCTION_TRUSTED_AUTHOR_IDS=
# FUNCTION_EXECUTION_TRUST_MODE=trusted-authors-only

# -----------------------------------------------------------------------------
# Local memory budget
#
# docker-compose.yml defaults to a single-user workstation profile whose
# aggregate container hard limits are ~8.3 GiB. These are escape hatches for
# large-data load tests; do not raise them all on a 16 GiB laptop.
# -----------------------------------------------------------------------------
# DUCKDB_MEMORY_LIMIT=384MB
# DUCKDB_THREADS=2
# TELLUS_WORKER_MAX_OLD_SPACE_MB=384
# TELLUS_APP_MEMORY_LIMIT=1G
# TELLUS_OPENSEARCH_MEMORY_LIMIT=1536M
# TELLUS_OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m -XX:MaxDirectMemorySize=256m
# TELLUS_OPENSEARCH_MEMORY_LOCK=false
# TELLUS_CLICKHOUSE_MEMORY_LIMIT=1G
# TELLUS_KAFKA_MEMORY_LIMIT=768M

# -----------------------------------------------------------------------------
# Action semantics v2 rollout
#
# Keep execution and creation disabled until link_instances bootstrap and
# reconciliation report zero mismatches. The kill switch overrides every v2
# flag and is intended for immediate operational rollback.
# -----------------------------------------------------------------------------
ACTION_SEMANTICS_V2_ENABLED=false
ACTION_SEMANTICS_V2_PROJECTION_READY=false
ACTION_SEMANTICS_V2_CREATION_ENABLED=false
ACTION_SEMANTICS_V2_KILL_SWITCH=false
