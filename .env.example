# PostgreSQL connection — override these with real credentials
PGHOST=localhost
PGPORT=5432
PGDATABASE=tellus_db
PGUSER=tellus
PGPASSWORD=changeme

# Optional: full connection URL (not used by the app directly)
# POSTGRES_URL=postgresql://tellus:changeme@localhost:5432/tellus_db

# Server
PORT=3000

# CORS — comma-separated list of allowed origins (empty = allow all in dev)
CORS_ORIGINS=

# File datasource — base directory for allowed file paths
DATA_DIR=./data


