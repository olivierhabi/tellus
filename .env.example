# =============================================================================
# Tellus / Ontology Engine — environment template
#
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`.
# Secrets (KEK, superadmin password, DB password, client secrets) MUST be
# sourced from a secrets manager in production — see SECURITY.md. The values
# here are non-functional placeholders only.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL connection (REQUIRED — see REQUIRED_ENV_VARS in src/server.ts)
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=tellus_db
PGUSER=tellus
PGPASSWORD=changeme
# Optional: full connection URL used by some tooling/migrations.
# DATABASE_URL=postgresql://tellus:changeme@localhost:5432/tellus_db
# POSTGRES_URL=postgresql://tellus:changeme@localhost:5432/tellus_db

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
# NODE_ENV gates dev-only behaviour (CORS allow-all, test-auth bypasses).
# MUST be "production" in production.
NODE_ENV=development
LOG_LEVEL=info

# CORS — comma-separated list of allowed origins.
# In production an empty value is FAIL-CLOSED (no cross-origin allowed); set the
# real frontend origin(s) explicitly, e.g. https://app.example.com
CORS_ORIGINS=

# File datasource — base directory for allowed file paths
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Credential vault / KMS  (SECRET — externalize in production)
# -----------------------------------------------------------------------------
# Base64-encoded 32-byte master key encrypting all stored connection creds.
# Generate (dev only): openssl rand -base64 32
# In production this MUST come from a secrets manager / KMS, never a baked .env.
TELLUS_LOCAL_KEK_B64=
TELLUS_KMS_ADAPTER=local

# -----------------------------------------------------------------------------
# Bootstrap superadmin  (SECRET — externalize in production)
# -----------------------------------------------------------------------------
TELLUS_SUPERADMIN_EMAIL=admin@example.com
TELLUS_SUPERADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Keycloak (SSO / OAuth 2.0)
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://localhost:8086
KEYCLOAK_REALM=tellus
KEYCLOAK_CLIENT_ID=tellus-api
KEYCLOAK_FRONTEND_CLIENT_ID=tellus-frontend
KEYCLOAK_CONFIDENTIAL_CLIENT_ID=tellus-confidential
# SECRET — externalize in production.
KEYCLOAK_CONFIDENTIAL_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Temporal (workflow engine)
# -----------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tellus

# -----------------------------------------------------------------------------
# ClickHouse (analytics)
# -----------------------------------------------------------------------------
CLICKHOUSE_URL=http://localhost:8123

# -----------------------------------------------------------------------------
# Lakekeeper / Iceberg catalog
# -----------------------------------------------------------------------------
LAKEKEEPER_URL=http://localhost:8181
LAKEKEEPER_WAREHOUSE=tellus
LAKEKEEPER_PIPELINE_WAREHOUSE=tellus-pipeline
TELLUS_ICEBERG_ROOT=s3://tellus-iceberg

# -----------------------------------------------------------------------------
# Redis (cache / rate-limit backend)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
TELLUS_REDIS_HOST=localhost
TELLUS_REDIS_PORT=6379
# RATE_LIMIT_BACKEND=redis

# -----------------------------------------------------------------------------
# Kafka (event streaming) — optional
# -----------------------------------------------------------------------------
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
# SECRET — externalize when SASL is enabled.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO / S3 object storage
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tellus-uploads
S3_ACCESS_KEY_ID=minioadmin
# SECRET — externalize in production.
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY=3600

# -----------------------------------------------------------------------------
# Quiver / frontend
# -----------------------------------------------------------------------------
TELLUS_QUIVER_PHASE=
TELLUS_FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Test-auth bypass flags — DEVELOPMENT / CI ONLY.
# These MUST stay UNSET in production. They are additionally gated by
# NODE_ENV !== "production" in code (defense in depth), but do not rely on that:
# leave them unset in any production environment.
# -----------------------------------------------------------------------------
# QUIVER_ALLOW_TEST_AUTH=1
# CODE_REPOS_TEST_AUTH=1
# TELLUS_TEST_HOOKS=1
