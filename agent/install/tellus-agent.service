[Unit]
Description=Tellus Agent (on-prem connectivity relay)
Documentation=https://docs.tellus.example/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tellus
Group=tellus
ExecStart=/opt/tellus/agent/bin/tellus-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/tellus/agent
ReadWritePaths=/var/lib/tellus/agent
CapabilityBoundingSet=
AmbientCapabilities=
LimitNOFILE=65536
TimeoutStopSec=60s
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
