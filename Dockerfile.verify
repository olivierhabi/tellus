# Dockerfile.verify — Quiver verification stack image (CONTRACT v1).
#
# This is a debian-slim variant of the production Dockerfile, used ONLY by
# docker-compose.verify.yml. It exists because the production Dockerfile
# bases the runtime stage on node:24-alpine (musl libc), but the project's
# transitive dependency @temporalio/core-bridge ships only glibc-linked
# native binaries for arm64 — on Apple Silicon hosts the relocator fails
# at boot:
#
#   Error relocating .../core-bridge/releases/aarch64-unknown-linux-gnu/index.node:
#       __register_atfork: symbol not found
#
# (musl does not expose __register_atfork; glibc does.) Production images
# happen to run on x86_64 Linux where the alpine path works; the verify
# stack on arm64 needs glibc. The harness builds this file via
# docker-compose.verify.yml's `dockerfile: Dockerfile.verify` directive.
#
# The two stages mirror the production layout exactly so the resulting
# /app/dist/server.js is a faithful representation of what production
# runs — only libc differs. Like production, it installs via pnpm with a
# frozen lockfile so the scanned tree equals the shipped tree.

FROM node:24-slim AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest-10 --activate
COPY package.json pnpm-lock.yaml tsconfig.json ./
RUN pnpm install --frozen-lockfile --ignore-scripts
COPY src/ src/
RUN pnpm exec tsc

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@latest-10 --activate
RUN groupadd --system appgroup && useradd --system -g appgroup appuser
# node:24-slim is minimal and ships neither wget nor curl. The healthcheck
# uses node's own http module (which is always present) instead.
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --prod --ignore-scripts && pnpm store prune
COPY --from=builder /app/dist/ dist/
COPY src/migrations/ src/migrations/
RUN mkdir -p /app/data && chown appuser:appgroup /app/data
USER appuser
EXPOSE 3000
HEALTHCHECK --interval=3s --timeout=3s --start-period=30s --retries=30 \
    CMD ["node", "-e", "require('http').get('http://localhost:3000/health', r => process.exit(r.statusCode===200?0:1)).on('error', () => process.exit(1))"]
CMD ["node", "dist/server.js"]
