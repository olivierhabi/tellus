# =============================================================================
# Test-only environment variables — copy to .env.test and fill in real values:
#
#   cp .env.test.example .env.test
#   set -a; source .env.test; set +a
#
# Two tiers:
#   1. Lane container passwords (PGPASSWORD, CLICKHOUSE_PASSWORD below) carry
#      the local-dev defaults that match docker-compose-test.yml. These are
#      ephemeral test-container credentials, already public in compose, and
#      serve as the FILE FALLBACK for tests/laneEnv.ts and
#      vitest.osv2-serving.config.ts (no credential literals in test code).
#      CI overrides them via environment (CI_PGPASSWORD) — env always wins.
#   2. Real credentials (API_KEY) have NO default here: the vitest configs
#      and shell test scripts FAIL FAST when these are unset instead of
#      falling back to baked-in credentials (security: no secrets in repo).
# =============================================================================

# PostgreSQL password for the test lanes. Required by:
#   - vitest.config.ts          (npm test / test:coverage — integration lane)
#   - vitest.unit.config.ts     (npm run test:unit — pure unit lane)
#   - vitest.osv2-serving.config.ts (OSv2 serving lane)
#   - tests/laneEnv.ts          (integration lane identity; env > file)
# Local default matches POSTGRES_PASSWORD in docker-compose-test.yml; CI
# exports CI_PGPASSWORD instead (env wins over this file).
PGPASSWORD=tellus123

# ClickHouse password for the test lanes. Required by:
#   - tests/laneEnv.ts          (integration lane identity; env > file)
#   - vitest.osv2-serving.config.ts (OSv2 serving lane)
# Local default matches the compose users.d credential; CI exports
# CLICKHOUSE_PASSWORD instead (env wins over this file).
CLICKHOUSE_PASSWORD=tellus_ch_pw

# API key used by the datasource shell test scripts against a running server:
#   - test-datasource-attach.sh
#   - test-datasource-funnel-trigger.sh
# Both scripts exit with an error when this is not exported.
API_KEY=
